/* 2.2 Consistent font, colour scheme and background */
body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f4f9;
    color: #333;
    margin: 0;
    padding: 0;
}

/* 2.3 Headings */
h1, h2 {
    color: #004a99;
    text-align: center;
}

/* 3.1 Header and horizontal nav */
header {
    background: #004a99;
    color: white;
    padding: 20px 0;
    border-bottom: 4px solid #ffcc00; /* 2.4 border */
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    padding: 0;
    margin: 10px 0 0 0;
}

nav ul li {
    margin: 0 15px;
}

/* 2.3 Links + 2.4 hover effect */
nav ul li a {
    color: white;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
}
nav ul li a:hover {
    background: #ffcc00;
    color: #004a99;
}

/* 2.3 Hero image */
.hero img {
    width: 100%;
    max-height: 300px;
    object-fit: cover;
    border-radius: 8px; /* 2.4 border */
    margin: 20px 0;
}

/* 3.2 Two column layout with flexbox */
.container {
    display: flex;
    gap: 20px; /* 2.4 margin/padding concept */
    padding: 20px;
}
.container section {
    flex: 2;
}
.container aside {
    flex: 1;
}

/* 3.3 Callout box */
.callout {
    background: #fff3cd;
    border-left: 5px solid #ffcc00; /* 2.4 border */
    padding: 15px; /* 2.4 padding */
    margin: 20px 0; /* 2.4 margin */
}

/* 4.2 Table styling */
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
}
th, td {
    border: 1px solid #ddd; /* 4.2 borders */
    padding: 10px; /* 4.2 padding */
    text-align: left;
}
thead {
    background-color: #004a99; /* 4.2 header styling */
    color: white;
}
tbody tr:nth-child(even) {
    background-color: #e9e9e9; /* 4.2 alternating row colours */
}

/* 3.3 Footer */
footer {
    background: #333;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 20px;
}